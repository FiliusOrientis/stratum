{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "**",
      "!!**/.idea",
      "!!**/components/ui",
      "!!**/auto-imports.d.ts",
      "!!apps/web/coverage"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noChildrenProp": "error",
        "noConstAssign": "error",
        "noConstantCondition": "error",
        "noConstantMathMinMaxClamp": "error",
        "noConstructorReturn": "error",
        "noEmptyCharacterClassInRegex": "error",
        "noEmptyPattern": "error",
        "noGlobalObjectCalls": "error",
        "noInnerDeclarations": "error",
        "noInvalidBuiltinInstantiation": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noNonoctalDecimalEscape": "error",
        "noPrecisionLoss": "error",
        "noRenderReturnValue": "error",
        "noSelfAssign": "error",
        "noSetterReturn": "error",
        "noStringCaseMismatch": "error",
        "noSwitchDeclarations": "error",
        "noUnreachable": "error",
        "noUnreachableSuper": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedFunctionParameters": "warn",
        "noUnusedImports": "warn",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "warn",
        "noVoidElementsWithChildren": "error",
        "noVoidTypeReturn": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useIsNan": "error",
        "useJsxKeyInIterable": "error",
        "useValidForDirection": "error",
        "useYield": "error",
        "useValidTypeof": "error",
        "noUnknownPseudoClass": "warn",
        "noUnknownPseudoElement": "warn",
        "noUnknownTypeSelector": "warn"
      },
      "suspicious": {
        "noApproximativeNumericConstant": "warn",
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noAsyncPromiseExecutor": "error",
        "noCatchAssign": "error",
        "noClassAssign": "error",
        "noCommentText": "warn",
        "noCompareNegZero": "error",
        "noConfusingLabels": "warn",
        "noConfusingVoidType": "error",
        "noConsole": "off",
        "noConstEnum": "warn",
        "noControlCharactersInRegex": "error",
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noEmptyBlockStatements": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "warn",
        "noExtraNonNullAssertion": "warn",
        "noFallthroughSwitchClause": "error",
        "noFunctionAssign": "error",
        "noGlobalAssign": "error",
        "noGlobalIsFinite": "warn",
        "noGlobalIsNan": "warn",
        "noImplicitAnyLet": "error",
        "noImportAssign": "error",
        "noLabelVar": "error",
        "noMisleadingCharacterClass": "warn",
        "noMisleadingInstantiator": "warn",
        "noMisrefactoredShorthandAssign": "warn",
        "noPrototypeBuiltins": "warn",
        "noRedeclare": "error",
        "noRedundantUseStrict": "error",
        "noSelfCompare": "error",
        "noShadowRestrictedNames": "error",
        "noSparseArray": "warn",
        "noSuspiciousSemicolonInJsx": "error",
        "noThenProperty": "warn",
        "noUnsafeDeclarationMerging": "error",
        "noUnsafeNegation": "error",
        "useAwait": "error",
        "useDefaultSwitchClauseLast": "warn",
        "useErrorMessage": "warn",
        "useGetterReturn": "error",
        "useIsArray": "warn",
        "useNamespaceKeyword": "warn",
        "useNumberToFixedDigitsArgument": "warn",
        "noVar": "error",
        "noWith": "error",
        "noDocumentCookie": "warn",
        "noDuplicateElseIf": "warn",
        "noIrregularWhitespace": "error",
        "noTemplateCurlyInString": "error",
        "useGuardForIn": "warn",
        "useStrictMode": "warn"
      },
      "style": {
        "noDefaultExport": "off",
        "noDoneCallback": "warn",
        "noImplicitBoolean": "warn",
        "noInferrableTypes": "off",
        "noNamespace": "off",
        "noNegationElse": "warn",
        "noNonNullAssertion": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "packages/3d-engine-vendor": "Do not import legacy vendor code directly."
            }
          }
        },
        "noParameterAssign": "warn",
        "noParameterProperties": "warn",
        "noRestrictedGlobals": {
          "level": "warn",
          "options": {
            "deniedGlobals": {
              "event": "Use a typed event parameter instead",
              "name": "Use a more descriptive variable name",
              "status": "Use a more descriptive variable name",
              "length": "Assign to a named constant first"
            }
          }
        },
        "noShoutyConstants": "off",
        "noUnusedTemplateLiteral": "warn",
        "noUselessElse": "warn",
        "noYodaExpression": "warn",
        "useAsConstAssertion": "warn",
        "useBlockStatements": "warn",
        "useCollapsedElseIf": "warn",
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "shorthand" }
        },
        "useConsistentBuiltinInstantiation": "warn",
        "useConst": "error",
        "useDefaultParameterLast": "warn",
        "useDefaultSwitchClause": "warn",
        "useEnumInitializers": "warn",
        "useExplicitLengthCheck": "warn",
        "useExponentiationOperator": "warn",
        "useExportType": "warn",
        "useFilenamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "filenameCases": ["kebab-case"]
          }
        },
        "useForOf": "warn",
        "useFragmentSyntax": "error",
        "useImportType": "error",
        "useLiteralEnumMembers": "warn",
        "useNamingConvention": "warn",
        "useNodeAssertStrict": "warn",
        "useNodejsImportProtocol": "warn",
        "useNumberNamespace": "warn",
        "useSelfClosingElements": "error",
        "useShorthandAssign": "warn",
        "useShorthandFunctionType": "warn",
        "useSingleVarDeclarator": "error",
        "useTemplate": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "noEnum": "warn",
        "noExportedImports": "warn",
        "noNestedTernary": "warn",
        "noSubstr": "warn",
        "useAtIndex": "warn",
        "useCollapsedIf": "warn",
        "useConsistentCurlyBraces": "warn",
        "useTrimStartEnd": "warn"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noEmptyTypeParameters": "warn",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveNestedTestSuites": "warn",
        "noExtraBooleanCast": "error",
        "noForEach": "warn",
        "noStaticOnlyClass": "warn",
        "noThisInStatic": "warn",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessEmptyExport": "warn",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "warn",
        "noUselessRename": "error",
        "noUselessStringConcat": "warn",
        "noUselessSwitchCase": "warn",
        "noUselessTernary": "warn",
        "noUselessThisAlias": "warn",
        "noUselessTypeConstraint": "warn",
        "noUselessUndefinedInitialization": "warn",
        "noVoid": "warn",
        "useArrowFunction": "error",
        "useDateNow": "warn",
        "useFlatMap": "warn",
        "useLiteralKeys": "warn",
        "useOptionalChain": "warn",
        "useRegexLiterals": "warn",
        "useSimpleNumberKeys": "warn",
        "useSimplifiedLogicExpression": "warn",
        "noFlatMapIdentity": "warn",
        "noUselessContinue": "warn",
        "noArguments": "error",
        "noCommaOperator": "error",
        "useNumericLiterals": "warn",
        "useWhile": "warn",
        "noAdjacentSpacesInRegex": "warn",
        "noUselessEscapeInRegex": "warn",
        "noUselessStringRaw": "warn"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noBarrelFile": "off",
        "noDelete": "warn",
        "noReExportAll": "warn",
        "useTopLevelRegex": "warn",
        "noNamespaceImport": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noBlankTarget": "warn",
        "noSecrets": "warn"
      },
      "a11y": {
        "noAccessKey": "warn",
        "noAriaHiddenOnFocusable": "warn",
        "noAriaUnsupportedElements": "warn",
        "noAutofocus": "warn",
        "noDistractingElements": "warn",
        "noHeaderScope": "warn",
        "noInteractiveElementToNoninteractiveRole": "warn",
        "noLabelWithoutControl": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "noNoninteractiveTabindex": "warn",
        "noPositiveTabindex": "warn",
        "noRedundantAlt": "warn",
        "noRedundantRoles": "warn",
        "noSvgWithoutTitle": "warn",
        "useAltText": "error",
        "useAnchorContent": "warn",
        "useAriaActivedescendantWithTabindex": "warn",
        "useAriaPropsForRole": "warn",
        "useButtonType": "warn",
        "useFocusableInteractive": "warn",
        "useGenericFontNames": "warn",
        "useHeadingContent": "warn",
        "useHtmlLang": "warn",
        "useIframeTitle": "warn",
        "useKeyWithClickEvents": "warn",
        "useKeyWithMouseEvents": "warn",
        "useMediaCaption": "warn",
        "useSemanticElements": "warn",
        "useValidAnchor": "warn",
        "useValidAriaProps": "error",
        "useValidAriaRole": "error",
        "useValidAriaValues": "error",
        "useValidLang": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useValidAutocomplete": "warn"
      },
      "nursery": {
        "useSortedClasses": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "json": {
    "parser": { "allowTrailingCommas": true },
    "formatter": { "indentWidth": 2 }
  }
}
