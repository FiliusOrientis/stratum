{
  "name": "stratum",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "commitlint": "commitlint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "audit:deps": "knip",
    "audit:structure": "depcruise --config .dependency-cruiser.cjs apps/web/src",
    "audit:all": "pnpm run audit:deps && pnpm run audit:structure",
    "docs-gate": "node scripts/docs-gate.mjs",
    "housekeeping-gate": "node scripts/pipeline-housekeeping.mjs",
    "check-collocated": "node scripts/check-collocated.mjs",
    "extract-ste-dictionary": "node scripts/extract-ste-dictionary.mjs",
    "prose": "vale sync && vale --config .vale.ini AGENTS.md CONTEXT.md CHANGELOG.md docs .agents/pipelines.md",
    "prose:ci": "vale sync && vale --config .vale-ci.ini AGENTS.md CONTEXT.md CHANGELOG.md docs .agents/pipelines.md"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "dependency-cruiser": "^18.2.0",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.21.0",
      "http-proxy-middleware": "^3.0.7",
      "qs": "^6.15.2"
    }
  }
}
